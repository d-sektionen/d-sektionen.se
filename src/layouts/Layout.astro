---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { Font } from "astro:assets";
import Aside from "../data/aside.mdx";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-rocky-aoe" />

        <slot name="head" />

        <title>Datateknologsektionen vid Linköpings universitet</title>
    </head>
    <body>
        <Navbar />
        <div class="grid grid-cols-[1fr_38em_1fr]">
            <div></div>
            <div>
                <slot />
            </div>
            <div>
                <Aside />
            </div>
        </div>
    </body>
</html>
