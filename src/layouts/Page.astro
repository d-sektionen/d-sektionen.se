---
import Layout from "./Layout.astro";
const { data } = Astro.props;
---

<Layout>
    <h1 class="text-2xl">{data.title}</h1>
    <hr />
    <!-- <div class="text-neutral-400 text-sm pb-4">{data?.date}</div> -->
    <main class="markdown">
        <slot />
    </main>
</Layout>

<style>
    .markdown {
        line-height: 1.2em;
        p {
            padding-block: 0.5em;
        }

        img {
            margin: auto;
            padding-block: 1em;
            max-width: 80%;
        }
    }
</style>
