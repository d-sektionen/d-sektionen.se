---
import type { MarkdownInstance } from "astro";
import { getCollection } from "astro:content";

import LogoDsektionen from "../assets/logo_dsektionen.svg";

const newsCollection = await getCollection("posts");

function summarize(content: string): string {
    let summary = content.trim().split(/\s+/).slice(0, 50).join(" ");
    if (content.length != summary.length) {
        summary += " [...]";
    }

    return summary;
}
---

<main class="max-w-3xl grid gap-12">
    {newsCollection.map((news) => (
        <a href={`/${news.id}`}>
            <article>
                <h2 class="bold text-xl">{news.data.title}</h2>
                <hr />
                <div class="text-foreground-500 text-sm pb-4">
                    {news.data.date}
                </div>
                <blockquote class="leading-6">
                    {news.body && summarize(news.body)}
                </blockquote>
            </article>
        </a>
    ))}
</main>
