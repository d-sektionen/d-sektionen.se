---
import type { MarkdownInstance } from "astro";

import LogoDsektionen from "../assets/logo_dsektionen.svg";

const newsItems: MarkdownInstance<{
    title: string;
    date: string;
}>[] = Object.values(import.meta.glob("../pages/news/*.md", { eager: true }));

function summarize(content: string): string {
    let summary = content.trim().split(/\s+/).slice(0, 50).join(" ");
    if (content.length != summary.length) {
        summary += " [...]";
    }

    return summary;
}
---

<main class="max-w-3xl grid gap-12">
    {newsItems.map((item) => (
        <a href={item.url}>
            <article>
                <h2 class="bold text-xl">{item.frontmatter.title}</h2>
                <hr />
                <div class="text-neutral-400 text-sm pb-4">
                    {item.frontmatter.date}
                </div>
                <blockquote class="leading-6">
                    {summarize(item.rawContent())}
                </blockquote>
            </article>
        </a>
    ))}
</main>
