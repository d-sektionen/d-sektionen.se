---
import FooterMDX from "@content/footer.mdx";
---

<footer class="bg-background-100 mt-4">
  <div class="grid grid-cols-5 pb-2">
    {[
      "bg-dsek-brown",
      "bg-dsek-pink",
      "bg-dsek-yellow",
      "bg-dsek-green",
      "bg-dsek-blue",
    ].map((color) => (
      <div class={`${color} h-1.5`} />
    ))}
  </div>
  <div class="text-center markdown">
    <FooterMDX />
  </div>
</footer>
