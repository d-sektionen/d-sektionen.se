---
import type { MarkdownInstance } from "astro";

import LogoDsektionen from "../assets/logo_dsektionen.svg";
import { getCollection } from "astro:content";

// const navItems: MarkdownInstance<{
//     title: string;
// }>[] = Object.values(
//     import.meta.glob("../pages/nav/*.{md,mdx}", { eager: true }),
// );
const navs = await getCollection("nav");
---

<nav class="sticky top-0 py-2 bg-background-50 w-full flex flex-col items-center">
    <div>
        <a href="/">
            <LogoDsektionen />
        </a>
    </div>
    <ul class="flex gap-1">
        {navs.map((item) => (
            <li>
                <a href={`/nav/${item.id}`} class="bg-primary text-foreground-50">
                    {item.data.title}
                </a>
            </li>
        ))}
    </ul>
</nav>
