---
import LogoDsektionen from "../assets/logo_dsektionen.svg";
import { getCollection } from "astro:content";

import {
    SiteNav,
    type Navigation,
    type SiteNavItem,
} from "@components/SiteNav";

const navs = await getCollection("nav");

// Entries carrying a `category` are gathered into a dropdown of that name;
// entries without one stay plain links. Sorting by title keeps the order
// stable between builds and matches what visitors read.
const entries = navs
    .map((nav) => ({
        href: `/${nav.id}`,
        title: nav.data.title,
        category: nav.data.category,
    }))
    .sort((a, b) => a.title.localeCompare(b.title, "sv"));

const groups = new Map<string, SiteNavItem[]>();
const links: SiteNavItem[] = [];

for (const { href, title, category } of entries) {
    if (category === undefined) {
        links.push({ title, href });
        continue;
    }

    const group = groups.get(category) ?? [];
    group.push({ title, href });
    groups.set(category, group);
}

// Categories first, alphabetically, then the plain links.
const items: Navigation = [];

for (const [category, groupItems] of [...groups].sort(([a], [b]) =>
    a.localeCompare(b, "sv"),
)) {
    items.push([category, groupItems]);
}

items.push(...links);
---

<nav class="sticky z-100 top-0 pt-2 mb-2 bg-background-50 w-full flex flex-col items-center shadow-sm">
    <div class="pb-4">
        <a href="/" aria-label="d-sektionen">
            <LogoDsektionen />
        </a>
    </div>
    <!--
      client:only is required, not a preference. Base UI's store code imports
      use-sync-external-store's CJS shim, which under Preact compat loads
      preact's CJS build while Astro's ESM renderer uses the ESM build. The two
      copies keep separate hook state, so server rendering throws
      "Cannot read properties of undefined (reading '__H')".
      Upstream: https://github.com/mui/base-ui/issues/4670 (open).
      Trade-off: the menu is no longer in the served HTML.
    -->
    <div class="min-h-9">
        <SiteNav client:only="preact" items={items} />
    </div>
</nav>
