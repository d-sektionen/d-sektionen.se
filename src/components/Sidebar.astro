---
import { getCollection } from "astro:content";

// D-section colors
const pixelColors = [
  "bg-dsek-brown",
  "bg-dsek-pink",
  "bg-dsek-yellow",
  "bg-dsek-green",
  "bg-dsek-blue",
];

const pages = await getCollection("pages");

// Pages with a `sidebar` number, lowest first
const entries = pages
  .filter((page) => page.data.sidebar !== undefined)
  .map((page) => ({
    href: `/${page.id}`,
    title: page.data.title,
    order: page.data.sidebar ?? 0,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "sv"));
---

{entries.length > 0 && (
  <nav
    aria-label="Snabblänkar"
    class="w-70 bg-background-100 shadow-sm outline-1 outline-background-300"
  >
    <ul>
      {entries.map(({ href, title }, index) => (
        <li>
          <a
            href={href}
            class="group flex h-12 items-center gap-3 text-xl transition-colors hover:bg-background-300"
          >
            <span
              aria-hidden="true"
              class={`size-12 shrink-0 rounded-xs opacity-0 transition-opacity duration-600 group-hover:opacity-100 ${pixelColors[index % pixelColors.length]}`}
            />
            {title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
