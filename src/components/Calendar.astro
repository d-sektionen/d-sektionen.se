---
import { getCollection } from "astro:content";
import type { CalendarEvent } from "@lib/calendar";
import day from "@lib/dayjs";
import Event from "./Event.astro";

const events = await getCollection("events");
events.sort(
  (a, b) =>
    a.data.start.getTime() - b.data.start.getTime() ||
    a.data.uid.localeCompare(b.data.uid),
);

const selectedEvents: {
  id: string;
  event: CalendarEvent;
  link: string | null;
}[] = [];

for (const event of events) {
  if (selectedEvents.length >= 10) {
    break;
  }

  // if the event has already ended
  if (day(event.data.end).isBefore(day())) {
    continue;
  }

  const description = event.data.description?.trim();
  let link = null;
  if (description?.startsWith("http")) {
    link = description;
  }

  selectedEvents.push({
    id: event.id,
    event: event.data,
    link,
  });
}
---

{selectedEvents
  .slice(0, 10)
  .map(({ id, event, link }) => <Event id={id} event={event}, link={link} />)}
