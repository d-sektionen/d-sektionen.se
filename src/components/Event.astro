---
import { type CalendarEvent } from "@lib/calendar";
import sanitizeHtml from "sanitize-html";
import day from "dayjs";

interface Props {
    event: CalendarEvent;
}

const { event } = Astro.props;
const start = day(event.start);
const end = day(event.end);
const description = event.description
    ? sanitizeHtml(event.description, { allowedTags: [] })
    : "";
---

<a
    href={`/calendar/${event.uid}`}
    class="flex h-fit gap-4 bg-background-100 p-2 w-70 outline-1 outline-background-300 shadow-sm"
>
    <div class="flex flex-col aspect-square items-center bg-background-200 p-2 justify-between size-22">
        <span class="text-sm">{start.format("dddd")}</span>

        <span class="text-3xl">{start.format("D")}</span>

        <span class="text-xs">{start.format("MMMM")}</span>
    </div>

    <div class="flex flex-col justify-between flex-1">
        <div>
            <div>{event.title}</div>
            <!-- <div
                set:text={description}
                class="text-sm text-foreground-600 description"
            /> -->
        </div>

        {event.allDay || (
            <div class="flex justify-end">
                <div class="text-sm text-foreground-800 bg-background-50 px-2 outline-1 outline-background-200">
                    {start.isSame(end, "day")
                        ? `${start.format("HH:mm")} - ${end.format("HH:mm")}`
                        : `${start.format("YY-MM-DD")} - ${end.format("YY-MM-DD")}`}
                </div>
            </div>
        )}
    </div>
</a>
