---
import type { CalendarEvent } from "@lib/calendar";
import EventBody from "./EventBody.astro";

interface Props {
  id: string;
  event: CalendarEvent;
  link: string | null;
}

const { link } = Astro.props;
---

{
  link ?
    <a href={link} target="_blank" >
      <EventBody {...Astro.props}/>
    </a>
  :
    <EventBody {...Astro.props}/>
}