---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!-- biome-ignore lint/a11y/useAnchorContent: slot provides content from parent -->
<a href={href} class="social-button opacity-75">
  <slot />
</a>

<style>
  .social-button {
    &:hover {
      filter: brightness(0) saturate(100%) invert(63%) sepia(77%)
        saturate(6276%) hue-rotate(307deg) brightness(90%) contrast(100%);
    }

    & img {
      width: 3em;
    }
  }
</style>
