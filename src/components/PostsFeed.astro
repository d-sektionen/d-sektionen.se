---
import type { InferEntrySchema } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import day from "@lib/dayjs";
import sanitizeHtml from "sanitize-html";

interface Props {
  posts: {
    id: string;
    body?: string;
    data: InferEntrySchema<"posts">;
  }[];
}

const { posts } = Astro.props;

const mdProcessor = await createMarkdownProcessor();

// Sort by date
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

async function summarize(content: string): Promise<string> {
  let render = await mdProcessor.render(content);
  let plain = sanitizeHtml(render.code, { allowedTags: [] });

  // Get first 50 words
  let summary = plain.trim().split(/\s+/).slice(0, 50).join(" ");

  // Some of the content got cut off
  if (summary != plain) {
    summary += " [...]";
  }

  return summary;
}
---

<main class="max-w-3xl grid gap-12">
  {posts.slice(0, 10).map((post) => (
    <a href={`/${post.id}`} class="group overflow-hidden">
      <article>
        <h2 class="bold text-xl group-hover:underline group-hover:text-primary">
          {post.data.title}
        </h2>
        <hr />
        <div class="text-foreground-500 text-sm pb-4">
          {day(post.data.date).format("YYYY-MM-DD")}
        </div>
        <blockquote class="leading-6">
          {post.body ? summarize(post.body) : null}
        </blockquote>
      </article>
    </a>
  ))}
</main>
