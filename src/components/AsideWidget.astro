---
import { Image } from "astro:assets";

interface Props {
    title: string;
    src: ImageMetadata;
    alt: string;
    href?: string;
}

const { title, src, alt, href } = Astro.props;
---

<aside class="flex justify-start pl-4">
    <a href={href} class="flex items-center flex-col gap-4">
        <h3>{title}</h3>
        <Image src={src} alt={alt} class="w-38" />
    </a>
</aside>
