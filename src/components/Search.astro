---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<PagefindConfig />
<div class="h-(--pf-input-height)">
    <pagefind-searchbox shortcut="/" class="pagefind"></pagefind-searchbox>
</div>

<style>
    .pagefind {
        width: calc(70 * var(--spacing) + 1px);
        --pf-border-radius: 0;
        --pf-outline-focus: var(--color-dsek-pink);
    }
</style>
