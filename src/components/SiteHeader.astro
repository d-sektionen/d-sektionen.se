---
/**
 * Builds the navigation from the `pages` content collection and passes the
 * resulting data to `Navbar`, the React component that is hydrated in the
 * browser.
 */
import { getCollection } from "astro:content";
import { Navbar } from "@components/Navbar";
import type { Navigation, SiteNavItem } from "@components/SiteNav";

const pages = await getCollection("pages");

// Entries carrying a `category` are gathered into a dropdown of that name;
// entries without one stay plain links. Sorting by title keeps the order
// stable between builds and matches what visitors read.
const entries = pages
  .map((page) => ({
    href: `/${page.id}`,
    title: page.data.title,
    category: page.data.category,
  }))
  .sort((a, b) => a.title.localeCompare(b.title, "sv"));

const groups = new Map<string, SiteNavItem[]>();
const links: SiteNavItem[] = [];

for (const { href, title, category } of entries) {
  if (category === undefined) {
    links.push({ title, href });
    continue;
  }

  const group = groups.get(category) ?? [];
  group.push({ title, href });
  groups.set(category, group);
}

// Categories first, alphabetically, then the plain links.
const items: Navigation = [];

for (const [category, groupItems] of [...groups].sort(([a], [b]) =>
  a.localeCompare(b, "sv"),
)) {
  items.push([category, groupItems]);
}

items.push(...links);
---

<Navbar client:idle items={items} />
