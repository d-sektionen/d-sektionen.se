---
import { getCollection } from "astro:content";
import PostsFeed from "@components/posts-feed/PostsFeed.astro";
import Layout from "@layouts/Layout.astro";
import {
  getCategoryPosts,
  getPostFeedPage,
  type PostFeedPage,
} from "@lib/posts";

export async function getStaticPaths() {
  const [categories, posts] = await Promise.all([
    getCollection("categories"),
    getCollection("posts"),
  ]);

  return categories.map((category) => ({
    params: { id: category.id },
    props: getPostFeedPage(getCategoryPosts(posts, category.id), 1, {
      pagePath: `/kategori/${category.id}/page`,
      firstPagePath: `/kategori/${category.id}`,
    }),
  }));
}

type Props = PostFeedPage;

const { posts, pagination } = Astro.props;
---

<Layout>
  <PostsFeed posts={posts} pagination={pagination} />
</Layout>
