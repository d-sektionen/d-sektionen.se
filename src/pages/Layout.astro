---
import Layout from "../layouts/Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout>
    <h1 class="text-2xl">{frontmatter.title}</h1>
    <hr />
    <div class="text-neutral-400 text-sm pb-4">{frontmatter.date}</div>
    <main class="markdown">
        <slot />
    </main>
</Layout>

<style>
    .markdown {
        line-height: 1.2em;
        p {
            padding-block: 0.5em;
        }

        img {
            margin: auto;
            padding-block: 1em;
            max-width: 80%;
        }
    }
</style>
